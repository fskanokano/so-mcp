# 代理鉴权密钥（必填，服务端读取，永不回传客户端）
PROXY_API_KEY=
# 搜索 / 抓取供应商密钥（Tinyfish，十六家任一非空即可启动）
TINYFISH_API_KEY=
# 搜索 / 抓取供应商密钥（Tavily，十六家任一非空即可启动）
TAVILY_API_KEY=
# 搜索 / 抓取供应商密钥（Exa，十六家任一非空即可启动）
EXA_API_KEY=
# 搜索供应商密钥（LangSearch，十六家任一非空即可启动）
LANGSEARCH_API_KEY=
# 搜索 / 抓取供应商密钥（You.com，十六家任一非空即可启动）
YOUCOM_API_KEY=
# 搜索供应商密钥（Querit，十六家任一非空即可启动）
QUERIT_API_KEY=
# 搜索 / 抓取供应商密钥（HasData，十六家任一非空即可启动）
HASDATA_API_KEY=
# 搜索 / 抓取供应商密钥（Firecrawl，十六家任一非空即可启动）
FIRECRAWL_API_KEY=
# 抓取供应商密钥（Scrape.do，十六家任一非空即可启动）
SCRAPEDO_API_KEY=
# 抓取供应商密钥（ScraperAPI，十六家任一非空即可启动）
SCRAPERAPI_API_KEY=
# 抓取供应商密钥（Bright Data，十六家任一非空即可启动）
BRIGHTDATA_API_KEY=
# 抓取供应商密钥（Browserless，十六家任一非空即可启动）
BROWSERLESS_API_KEY=
# 搜索 / 抓取供应商密钥（Jina，十六家任一非空即可启动）
JINA_API_KEY=
# 抓取供应商密钥（ScrapingAnt，十六家任一非空即可启动）
SCRAPINGANT_API_KEY=
# 抓取供应商密钥（Apify，十六家任一非空即可启动）
APIFY_API_KEY=
# 搜索供应商密钥（GNews，十六家任一非空即可启动）
GNEWS_API_KEY=
# 默认搜索供应商（默认 tinyfish，单源语义保留）
SEARCH_PROVIDER=tinyfish
# 默认抓取主供应商（默认 tinyfish，主备语义保留）
FETCH_PRIMARY=tinyfish
# 默认抓取兜底供应商（默认 tavily，主备语义保留）
FETCH_FALLBACK=tavily
# 搜索扇出名单（逗号分隔，默认 tinyfish,tavily,exa,langsearch,youcom,jina,querit,firecrawl,gnews,hasdata）
SEARCH_PROVIDERS=tinyfish,tavily,exa,langsearch,youcom,jina,querit,firecrawl,gnews,hasdata
# 抓取分级名单（逗号分隔，默认 tinyfish,tavily,exa,youcom,jina,scrapedo,scraperapi,scrapingant,firecrawl,hasdata,browserless,brightdata,apify，上限 16 级防烧钱）
FETCH_CHAIN=tinyfish,tavily,exa,youcom,jina,scrapedo,scraperapi,scrapingant,firecrawl,hasdata,browserless,brightdata,apify
# 验证搜索名单（逗号分隔，默认 tinyfish,tavily,exa,langsearch,youcom,jina,querit,firecrawl,gnews,hasdata）
VERIFY_SEARCH_PROVIDERS=tinyfish,tavily,exa,langsearch,youcom,jina,querit,firecrawl,gnews,hasdata
# 验证抓取名单（逗号分隔，默认 tinyfish,tavily,exa,youcom,jina,scrapedo,scraperapi,scrapingant,firecrawl,hasdata,browserless,brightdata,apify）
VERIFY_FETCH_CHAIN=tinyfish,tavily,exa,youcom,jina,scrapedo,scraperapi,scrapingant,firecrawl,hasdata,browserless,brightdata,apify
# 余额查询超时毫秒数（默认 15000，十六家扇出共用此超时）
CREDITS_TIMEOUT_MS=15000
